# ╔══════════════════════════════════════════════════════════════╗
# ║  n8n production — variables d'environnement                 ║
# ║  Copier vers .env et remplir avant docker compose up        ║
# ╚══════════════════════════════════════════════════════════════╝

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=ChangeMe_Postgres!
DB_POSTGRESDB_DATABASE=n8n

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=ChangeMe_Redis!

# ── n8n sécurité ─────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=ChangeMe_EncryptionKey_32CharsMin!

# ── URLs (via Cloudflare Tunnel) ─────────────────────────────────────────────
N8N_HOST=n8n.votredomaine.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.votredomaine.com/
N8N_SECURE_COOKIE=true

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=votre_token_cloudflare

# ── Timezone ──────────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Europe/Paris

# ── (Optionnel) Logs n8n ──────────────────────────────────────────────────────
# N8N_LOG_LEVEL=info
# N8N_LOG_OUTPUT=console
