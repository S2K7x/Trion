      "parameters": {
        "jsCode": "const items = $input.all();\nconst alerts = items.filter(i => i.json && i.json.id);\nif (alerts.length === 0) return [];\nif (alerts.length > 50) {\n  return [{ json: { _queue_saturated: true, count: alerts.length } }];\n}\nreturn alerts.slice(0, 5).map(i => ({ json: i.json }));\n"
