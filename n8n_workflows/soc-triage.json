      "parameters": {
        "jsCode": "const item = $input.first().json;\n// Reject error bubbles (Continue on Fail upstream)\nif (item.error) return [];\n// Reject queue-saturation sentinel\nif (item._queue_saturated) return [];\n// Reject anything that is not a real pending alert\n// (e.g. Supabase Mark Done response loops back with status='done')\nconst alertId = Number(item.id);\nif (!alertId || !item.rule_id || item.status !== 'pending') return [];\nconst sd = $getWorkflowStaticData('global');\nsd.enrichedIocs = [];\nsd.currentAlert = item;\nreturn [{ json: item }];\n"
