        "jsCode": "const sd = $workflow.staticData;\nconst vtItems = $items('HTTP — VT Domain');\nconst vt = vtItems[0]?.json || {};\nconst stats     = vt.data?.attributes?.last_analysis_stats || {};\nconst malicious = stats.malicious || 0;\nconst total     = Object.values(stats).reduce((a,b)=>a+b, 0);\nlet verdict = 'CLEAN';\nif (malicious > 5) verdict = 'MALICIOUS';\nelse if (malicious > 0) verdict = 'SUSPICIOUS';\nif (!sd.enrichedIocs) sd.enrichedIocs = [];\nsd.enrichedIocs.push({\n  value: sd.currentIoc?.value || '?', type: 'domain',\n  vt_malicious: malicious, vt_total: total, verdict,\n});\nreturn [{ json: { loop_continue: true } }];\n"
      },
      "id": "t-26",
      "name": "Code — Format Domain Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3312,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd = $workflow.staticData;\nconst alert = sd.currentAlert || {};\nconst iocs  = sd.enrichedIocs || [];\nsd.enrichedIocs = [];\nconst level  = parseInt(alert.rule_level || 0);\nconst prefix = level >= 12 ? '[CRITICAL]' : level >= 8 ? '[HIGH]' : level >= 5 ? '[MEDIUM]' : '[LOW]';\nconst title  = alert.rule_desc || `Rule ${alert.rule_id}`;\nconst sep    = '───────────────────────────';\nconst ts     = new Date().toISOString().replace('T',' ').slice(0,19) + ' UTC';\nlet iocBlock = iocs.length === 0 ? '\\nno external ioc detected' : '\\nioc enrichment';\nfor (const ioc of iocs) {\n  iocBlock += `\\n  ${ioc.value}`;\n  if (ioc.type === 'ip') {\n    iocBlock += `\\n    vt       : ${ioc.vt_malicious}/${ioc.vt_total}  ← ${ioc.verdict}`;\n    if (ioc.abuse_confidence !== undefined) iocBlock += `\\n    abuse    : ${ioc.abuse_confidence}%`;\n  } else if (ioc.type === 'hash') {\n    iocBlock += `\\n    vt       : ${ioc.vt_malicious}/${ioc.vt_total}  ← ${ioc.verdict}`;\n    if (ioc.mwbazaar_found) iocBlock += `\\n    mwbazaar : known malware`;\n  } else if (ioc.type === 'domain') {\n    iocBlock += `\\n    vt       : ${ioc.vt_malicious}/${ioc.vt_total}  ← ${ioc.verdict}`;\n  }\n}\nconst lines = [\n  `${prefix} ${title}`, sep,\n  `rule_id   : ${alert.rule_id}`,\n  `agent     : ${alert.agent_name} (${alert.agent_ip})`,\n  alert.username ? `user      : ${alert.username}` : null,\n  alert.command  ? `command   : ${alert.command}`  : null,\n  iocBlock, '',\n  `${ts} · mini-soc/wazuh`,\n].filter(l => l !== null);\nreturn [{ json: { text: '```\\n' + lines.join('\\n') + '\\n```', alert_id: alert.id } }];\n"
      },
