    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst vtItems    = $items('HTTP \u2014 VT IP');\nconst abuseItems = $items('HTTP \u2014 AbuseIPDB');\nconst vt    = vtItems[0]?.json    || {};\nconst abuse = abuseItems[0]?.json || {};\nconst vtError = !!vt.error;\nconst stats     = vt.data?.attributes?.last_analysis_stats || {};\nconst malicious = Number(stats.malicious) || 0;\nconst total     = Object.values(stats).reduce((a, b) => a + (Number(b) || 0), 0);\nconst abusePct  = Number(abuse.data?.abuseConfidenceScore) || 0;\nlet verdict = vtError ? 'UNKNOWN' : 'CLEAN';\nif (!vtError) {\n  if (malicious > 5 || abusePct > 50) verdict = 'MALICIOUS';\n  else if (malicious > 0 || abusePct > 10) verdict = 'SUSPICIOUS';\n}\nif (!sd.enrichedIocs) sd.enrichedIocs = [];\nsd.enrichedIocs.push({\n  value: sd.currentIoc?.value || '?', type: 'ip',\n  vt_malicious: malicious, vt_total: total,\n  abuse_confidence: abusePct, verdict,\n  vt_error: vtError || undefined,\n});\nreturn [{ json: { loop_continue: true } }];\n"
      },
