        "jsCode": "const sd = $workflow.staticData;\nconst vtItems = $items('HTTP — VT Hash');\nconst mwItems = $items('HTTP — MalwareBazaar');\nconst vt  = vtItems[0]?.json || {};\nconst mw  = mwItems[0]?.json || {};\nconst stats     = vt.data?.attributes?.last_analysis_stats || {};\nconst malicious = stats.malicious || 0;\nconst total     = Object.values(stats).reduce((a,b)=>a+b, 0);\nconst mwFound   = mw.query_status === 'ok' && Array.isArray(mw.data) && mw.data.length > 0;\nlet verdict = 'CLEAN';\nif (malicious > 5 || mwFound) verdict = 'MALICIOUS';\nelse if (malicious > 0) verdict = 'SUSPICIOUS';\nif (!sd.enrichedIocs) sd.enrichedIocs = [];\nsd.enrichedIocs.push({\n  value: sd.currentIoc?.value || '?', type: 'hash',\n  vt_malicious: malicious, vt_total: total,\n  mwbazaar_found: mwFound, verdict,\n});\nreturn [{ json: { loop_continue: true } }];\n"
