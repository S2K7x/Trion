    {
      "parameters": {
        "jsCode": "const sd = $workflow.staticData;\nconst vtItems    = $items('HTTP — VT IP');\nconst abuseItems = $items('HTTP — AbuseIPDB');\nconst vt    = vtItems[0]?.json    || {};\nconst abuse = abuseItems[0]?.json || {};\nconst stats     = vt.data?.attributes?.last_analysis_stats || {};\nconst malicious = stats.malicious || 0;\nconst total     = Object.values(stats).reduce((a,b)=>a+b, 0);\nconst abusePct  = abuse.data?.abuseConfidenceScore || 0;\nlet verdict = 'CLEAN';\nif (malicious > 5 || abusePct > 50) verdict = 'MALICIOUS';\nelse if (malicious > 0 || abusePct > 10) verdict = 'SUSPICIOUS';\nif (!sd.enrichedIocs) sd.enrichedIocs = [];\nsd.enrichedIocs.push({\n  value: sd.currentIoc?.value || '?', type: 'ip',\n  vt_malicious: malicious, vt_total: total,\n  abuse_confidence: abusePct, verdict,\n});\nreturn [{ json: { loop_continue: true } }];\n"
      },
