    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst vtItems = $items('HTTP \u2014 VT Domain');\nconst vt = vtItems[0]?.json || {};\nconst vtError = !!vt.error;\nconst stats     = vt.data?.attributes?.last_analysis_stats || {};\nconst malicious = Number(stats.malicious) || 0;\nconst total     = Object.values(stats).reduce((a, b) => a + (Number(b) || 0), 0);\nlet verdict = vtError ? 'UNKNOWN' : 'CLEAN';\nif (!vtError) {\n  if (malicious > 5) verdict = 'MALICIOUS';\n  else if (malicious > 0) verdict = 'SUSPICIOUS';\n}\nif (!sd.enrichedIocs) sd.enrichedIocs = [];\nsd.enrichedIocs.push({\n  value: sd.currentIoc?.value || '?', type: 'domain',\n  vt_malicious: malicious, vt_total: total, verdict,\n  vt_error: vtError || undefined,\n});\nreturn [{ json: { loop_continue: true } }];\n"
      },
      "id": "1e806b12-c2f2-459e-bd3a-562d9dc90adf",
      "name": "Code \u2014 Format Domain Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2208,
        992
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst alert = sd.currentAlert || {};\nconst iocs  = sd.enrichedIocs || [];\nsd.enrichedIocs  = [];\nsd.currentAlert  = null;\n// Safety: if alert has no id, bail \u2014 don't send garbled Slack message\nif (!alert.id) return [{ json: { _skipped: true } }];\nconst level  = parseInt(alert.rule_level ?? 0, 10);\nconst prefix = level >= 12 ? '[CRITICAL]' : level >= 8 ? '[HIGH]' : level >= 5 ? '[MEDIUM]' : '[LOW]';\nconst title  = alert.rule_desc || `Rule ${alert.rule_id || 'unknown'}`;\nconst sep    = '\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500';\nconst ts     = new Date().toISOString().replace('T',' ').slice(0,19) + ' UTC';\nlet iocBlock = iocs.length === 0 ? '\\nno external ioc detected' : '\\nioc enrichment';\nfor (const ioc of iocs) {\n  iocBlock += `\\n  ${ioc.value}`;\n  const errNote = ioc.vt_error ? ' (vt unavailable)' : '';\n  if (ioc.type === 'ip') {\n    iocBlock += `\\n    vt       : ${ioc.vt_malicious}/${ioc.vt_total}  \u2190 ${ioc.verdict}${errNote}`;\n    if (ioc.abuse_confidence !== undefined) iocBlock += `\\n    abuse    : ${ioc.abuse_confidence}%`;\n  } else if (ioc.type === 'hash') {\n    iocBlock += `\\n    vt       : ${ioc.vt_malicious}/${ioc.vt_total}  \u2190 ${ioc.verdict}${errNote}`;\n    if (ioc.mwbazaar_found) iocBlock += `\\n    mwbazaar : known malware`;\n  } else if (ioc.type === 'domain') {\n    iocBlock += `\\n    vt       : ${ioc.vt_malicious}/${ioc.vt_total}  \u2190 ${ioc.verdict}${errNote}`;\n  }\n}\nconst lines = [\n  `${prefix} ${title}`, sep,\n  `rule_id   : ${alert.rule_id   || 'n/a'}`,\n  `agent     : ${alert.agent_name || 'n/a'} (${alert.agent_ip || 'n/a'})`,\n  alert.username ? `user      : ${alert.username}` : null,\n  alert.command  ? `command   : ${alert.command}`  : null,\n  iocBlock, '',\n  `${ts} \u00b7 mini-soc/wazuh`,\n].filter(l => l !== null);\nreturn [{ json: { text: '```\\n' + lines.join('\\n') + '\\n```', alert_id: alert.id } }];\n"
      },
