    {
      "parameters": {
        "jsCode": "const sd    = $getWorkflowStaticData('global');\nconst alert = sd.currentAlert || {};\nif (!alert.id) return [];\nlet iocs = [];\nif (Array.isArray(alert.iocs)) {\n  iocs = alert.iocs;\n} else if (typeof alert.iocs === 'string' && alert.iocs.trim()) {\n  try { iocs = JSON.parse(alert.iocs); } catch { iocs = []; }\n}\nconst valid = iocs.filter(ioc => ioc && ioc.value && ioc.type);\nif (valid.length === 0) return [];\nreturn valid.map(ioc => ({\n  json: { ...alert, ioc_value: String(ioc.value), ioc_type: String(ioc.type).toLowerCase() }\n}));\n"
      },
