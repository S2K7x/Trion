# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key — Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server-side only, never expose to the browser)
# Project Settings → API → service_role secret
SUPABASE_SERVICE_KEY=

# ── Dashboard auth ────────────────────────────────────────────────────────────
# Password required to log in to the dashboard
DASHBOARD_PASSWORD=

# JWT signing secret — generate with: openssl rand -hex 32
# Must be at least 64 hex characters (32 bytes)
DASHBOARD_SECRET=

# ── Config encryption ─────────────────────────────────────────────────────────
# AES-256-GCM key used to encrypt API keys stored in Supabase
# Generate with: openssl rand -hex 32  (produces 64 hex chars = 32 bytes)
MASTER_SECRET=

# ── n8n ───────────────────────────────────────────────────────────────────────
# URL of your n8n instance (use Cloudflare Tunnel URL on Vercel, local URL for dev)
N8N_API_URL=http://localhost:5678

# n8n API key — n8n UI → Settings → API
N8N_API_KEY=
